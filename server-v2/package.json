{
  "name": "server-v2",
  "version": "1.0.0",
  "private": true,
  "description": "Spending tracker backend, production-grade rewrite",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.ts",
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "db:migration:create": "node ./node_modules/node-pg-migrate/bin/node-pg-migrate.js create -m migrations --migration-file-language sql --migration-filename-format index",
    "db:migrate": "node --env-file-if-exists=.env ./node_modules/node-pg-migrate/bin/node-pg-migrate.js up -m migrations",
    "db:migrate:test": "node --env-file-if-exists=.env ./node_modules/node-pg-migrate/bin/node-pg-migrate.js up -m migrations -d TEST_DATABASE_URL",
    "db:roles": "docker compose exec -T postgres psql -v ON_ERROR_STOP=1 -U spending -d spending_dev < docker/postgres/roles.sql",
    "db:roles:test": "docker compose exec -T postgres psql -v ON_ERROR_STOP=1 -U spending -d spending_test < docker/postgres/roles.sql",
    "db:rollback": "node --env-file-if-exists=.env ./node_modules/node-pg-migrate/bin/node-pg-migrate.js down -m migrations",
    "test": "npm run db:migrate:test && npm run db:roles:test && node --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "test:unit": "node --test \"test/unit/**/*.test.ts\"",
    "test:watch": "npm run db:migrate:test && npm run db:roles:test && node --test --test-concurrency=1 --watch \"test/**/*.test.ts\"",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "node-pg-migrate": "^9.0.0",
    "supertest": "^7.2.2",
    "typescript": "^5.9.3"
  }
}
